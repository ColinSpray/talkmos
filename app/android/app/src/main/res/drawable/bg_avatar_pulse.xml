<?xml version="1.0" encoding="utf-8"?>
<!-- One ring of the sonar pulse behind the avatar. Two of these are scaled and
     faded out on a loop (CallActivity.startPulse) — the native counterpart of
     PulsingAvatar's breathing glow on the Flutter call screen. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="#2E8873E8" />
    <stroke
        android:width="1dp"
        android:color="#4D8873E8" />
</shape>
