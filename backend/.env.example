# Copy to .env and fill in. .env is gitignored, so it never travels with a
# git pull — when a deploy fails on a "must be set" interpolation error, it is
# because a new variable landed here but not on the server.
#
#   cp .env.example .env
#
# Compose refuses to start without MONGO_ROOT_PASSWORD, REDIS_PASSWORD,
# MINIO_ACCESS_KEY and MINIO_SECRET_KEY — those have no safe default.

PORT=5000
# Must repeat MONGO_ROOT_PASSWORD inline — dotenv does not expand ${VARS}.
MONGO_URI=mongodb://root:SAME-AS-MONGO_ROOT_PASSWORD@mongo:27017/talkmos?authSource=admin&replicaSet=rs0
JWT_SECRET=change-me-to-a-long-random-string

# ─── Media storage (external MinIO at gcdn.ahamcloudservices.com) ─────────────
# Not run by this compose file — it is someone else's deployment. Presigned
# uploads are signed against this host, so it must be the address CLIENTS
# reach, and it must be the S3 API endpoint (not a read-only CDN).
MINIO_ENDPOINT=https://gcdn.ahamcloudservices.com
# Base for the permanent read URLs stored on messages. Same host here; set it
# apart only if reads ever move to a separate CDN.
MEDIA_BASE_IMAGE_URL=https://gcdn.ahamcloudservices.com
MINIO_BUCKET=talkmostest
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
# How long a client has to start its upload after asking for the URL.
MINIO_UPLOAD_EXPIRY_SECONDS=900
LIVEKIT_URL=wss://livekit.talkmos.com
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
TRANSLATE_SERVICE_URL=https://translate.talkmos.com
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
MONGO_ROOT_PASSWORD=change-me-generate-with-openssl-rand-base64-24
CLUSTER_WORKERS=auto
HTTP_LOG_LEVEL=error
MONGO_AUTO_INDEX=false
MONGO_POOL_SIZE=15
REDIS_PASSWORD=change-me-generate-with-openssl-rand-base64-24
# Must repeat REDIS_PASSWORD inline — dotenv does not expand ${VARS}.
REDIS_URL=redis://:SAME-AS-REDIS_PASSWORD@redis:6379
OTP_AUTOFILL=true
GRAFANA_ADMIN_PASSWORD=change-me

# ─── Nearby tuning ────────────────────────────────────────────────────────────
# All optional. Every one has a default in src/config/nearby.js that matches
# the value shown here, so commenting a line out changes nothing.

# How long a reported position stays usable, in seconds. The staleness vs
# coverage dial: raise it if lists come back empty, lower it if people show up
# somewhere they have already left.
NEARBY_PRESENCE_TTL_SECONDS=1800

# Decimal places positions are snapped to before storage. 3 is ~110m.
# A privacy setting, not a tuning one — raising it stores a more precise
# location than the consent sheet discloses.
NEARBY_GRID_DECIMALS=3

# Search radius in metres, and the ceiling a caller may ask for.
NEARBY_DEFAULT_RADIUS_M=500
NEARBY_MAX_RADIUS_M=2000
NEARBY_MAX_RESULTS=60

# How old a stored fix may be and still be worth falling back to, in seconds.
# Applies when a device was asked for a fresh position and did not answer.
NEARBY_LAST_KNOWN_MAX_AGE_SECONDS=21600

# Tier boundaries in metres. Compared against grid-quantised distances, so
# values below one grid cell buy nothing.
NEARBY_TIER_RIGHT_HERE_M=120
NEARBY_TIER_VERY_CLOSE_M=350

# Minimum gap between silent location pushes to the same user, in seconds.
# Guards against APNs throttling and Android battery-manager kills.
NEARBY_LOCATE_COOLDOWN_SECONDS=300

# Must stay byte-identical to the app's legacy ENCRYPTION_KEY.
# Every message already stored — on the server and on devices — was
# encrypted with a key derived from it, so changing it orphans all of them.
# Rotating means re-encrypting, not just editing this line.
MESSAGE_KEY_SALT=must-match-the-apps-legacy-ENCRYPTION_KEY-byte-for-byte

# Which key the salt above is. Never defaulted and never guessed: the server
# refuses to boot without it, because a wrong id makes clients encrypt under a
# key nobody else derives and nothing about that is visible until someone tries
# to read the message. Bump it only when every client can read the new key.
MESSAGE_KEY_ID=0

# How long a call is held open for a participant whose socket dropped, before
# the leave is finalized. Covers a web client reloading its page; native apps
# keep their socket across backgrounding. Default 15000.
CALL_RECONNECT_GRACE_MS=15000
