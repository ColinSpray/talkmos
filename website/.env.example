# Copy to .env on every deploy target:  cp .env.example .env
#
# docker compose reads .env (never .env.local) for ${...} substitution in
# docker-compose.yml, so both values below have to be present here.

# Inlined into the client bundle at BUILD time — a change needs a rebuild.
NEXT_PUBLIC_API_BASE_URL=https://stage-api.talkmos.com/api/v1

# Read per request on the server — a change needs only a restart.
GRAFANA_URL=https://logs.talkmos.com
